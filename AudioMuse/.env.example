# AudioMuse 服务环境变量示例：复制为 .env 后按需修改
# 所有变量前缀 AUDIOMUSE_，与 app/config.py 中的 Settings 字段对应

# 运行
AUDIOMUSE_APP_NAME=AudioMuse 录音转写服务
AUDIOMUSE_LOG_LEVEL=INFO
AUDIOMUSE_DEBUG=false

# 数据目录：录音文件与 SQLite 数据库均存放于此（相对项目根目录或绝对路径）
# AUDIOMUSE_DATA_DIR=data

# 上传大小上限（字节），默认 50 * 1024 * 1024
# AUDIOMUSE_MAX_UPLOAD_BYTES=52428800

# 异步流水线：全局最多同时处理的录音任务数（P0 起生效）
AUDIOMUSE_MAX_CONCURRENCY=3

# LLM（真实摘要阶段使用，后续阶段实现；密钥只从环境读取，勿提交仓库）
# AUDIOMUSE_LLM_API_KEY=
# AUDIOMUSE_LLM_BASE_URL=
# AUDIOMUSE_LLM_MODEL=
# AUDIOMUSE_LLM_TIMEOUT_SECONDS=30

# ASR Mock 参数（默认 5~15s、约 20% 失败；测试/演示可用环境变量调小）
# AUDIOMUSE_ASR_MIN_SECONDS=5
# AUDIOMUSE_ASR_MAX_SECONDS=15
# AUDIOMUSE_ASR_FAILURE_THRESHOLD=0.2

# ASR/LLM 阶段内自动重试：最多 3 次，默认按 1/2/4 秒指数退避
# AUDIOMUSE_AUTO_RETRY_MAX_RETRIES=3
# AUDIOMUSE_AUTO_RETRY_BASE_DELAY_SECONDS=1
